{
  "name": "lorobuy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LoroBuy storefront backed by Supabase and prepared for Render.",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "predev": "npm run build",
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "start": "node src/server.mjs",
    "pretest": "npm run build",
    "test": "node --test test/project.test.mjs test/server.integration.test.mjs",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "express": "5.2.1",
    "helmet": "8.3.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
