# Public project endpoint. Keep the real value in Render, not in Git.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Low-privilege key. RLS remains the authorization boundary.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Backend-only key. Never expose it in frontend code or commit a real value.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Exact public origin of the Render service, without a trailing slash.
APP_ORIGIN=https://lorobuy.onrender.com

# Lemon Squeezy backend-only payment configuration.
LEMON_SQUEEZY_API_KEY=REPLACE_ME
LEMON_SQUEEZY_STORE_ID=REPLACE_ME
LEMON_SQUEEZY_WEBHOOK_SECRET=REPLACE_ME

# Keep true until test purchases and signed webhooks have been verified.
LEMON_SQUEEZY_TEST_MODE=true

# Render provides PORT automatically. Use this only for local development.
PORT=10000
NODE_ENV=development
